generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // o "postgresql", según tu base de datos
  url      = env("DATABASE_URL")
}

// Usuarios y notificaciones para gestión de acceso y comunicación
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  username  String
  key       String?
  secretKey String?
  createdAt DateTime @default(now())

  profile       Profile?       @relation(fields: [profileId], references: [id])
  profileId     Int?           @unique
  sessions      Session[]
  notifications Notification[]
  accounts      Account[] // Relación con cuentas
}

model Profile {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String?
  birthDate DateTime?
  address   String?
  createdAt DateTime  @default(now())

  user User? @relation
}

model Session {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?
  ipAddress String?
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Tipos de cuentas bancarias (ahorro, spot, margin, cruzado, etc.)
model BankAccountType {
  id          Int       @id @default(autoincrement())
  typeName    String
  description String?
  createdAt   DateTime  @default(now())
  accounts    Account[]
}

// Monedas (fiat y criptomonedas)
model Currency {
  code        String   @id @db.VarChar(5)
  description String?
  createdAt   DateTime @default(now())

  accountBalances   AccountBalance[]
  tradingPairsBase  TradingPair[]      @relation("BaseCurrency")
  tradingPairsQuote TradingPair[]      @relation("QuoteCurrency")
  journalEntryLines JournalEntryLine[]
  transfers         Transfer[]
}

// Cuentas bancarias jerárquicas con claves de acceso, ligadas a usuario
model Account {
  id                Int      @id @default(autoincrement())
  userId            Int
  parentAccountId   Int?
  bankAccountTypeId Int
  key               String
  secretKey         String
  email             String   @unique
  password          String
  createdAt         DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id])
  parentAccount     Account?           @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  subAccounts       Account[]          @relation("AccountHierarchy")
  bankAccountType   BankAccountType    @relation(fields: [bankAccountTypeId], references: [id])
  accountBalances   AccountBalance[]
  journalEntryLines JournalEntryLine[]
  fromTransfers     Transfer[]         @relation("FromAccount")
  toTransfers       Transfer[]         @relation("ToAccount")
  tradingOrders     TradingOrder[]
}

// Saldo de cada cuenta por moneda
model AccountBalance {
  id           Int     @id @default(autoincrement())
  accountId    Int
  currencyCode String  @db.VarChar(5)
  balance      Decimal @default(0)

  account  Account  @relation(fields: [accountId], references: [id])
  currency Currency @relation(fields: [currencyCode], references: [code])

  @@unique([accountId, currencyCode])
}

// Estados para transacciones y transferencias
model TransactionStatus {
  id             Int            @id @default(autoincrement())
  statusName     String
  journalEntries JournalEntry[]
  transfers      Transfer[]
}

// Asientos contables (movimientos generales)
model JournalEntry {
  id          Int      @id @default(autoincrement())
  entryDate   DateTime
  description String?
  createdBy   String?
  statusId    Int      @default(1)
  createdAt   DateTime @default(now())

  status   TransactionStatus  @relation(fields: [statusId], references: [id])
  lines    JournalEntryLine[]
  transfer Transfer?
}

// Detalles de asiento contable con partidas dobles
model JournalEntryLine {
  id           Int     @id @default(autoincrement())
  entryId      Int
  accountId    Int     @map("accountId")
  currencyCode String  @db.VarChar(5)
  amount       Decimal
  entryType    String

  journalEntry JournalEntry @relation(fields: [entryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
  currency     Currency     @relation(fields: [currencyCode], references: [code])
}

// Transferencias entre cuentas
model Transfer {
  id             Int      @id @default(autoincrement())
  fromAccountId  Int
  toAccountId    Int
  currencyCode   String   @db.VarChar(5)
  amount         Decimal
  transferDate   DateTime @default(now())
  journalEntryId Int      @unique
  description    String?
  statusId       Int      @default(1)

  fromAccount  Account           @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount    Account           @relation("ToAccount", fields: [toAccountId], references: [id])
  currency     Currency          @relation(fields: [currencyCode], references: [code])
  journalEntry JournalEntry      @relation(fields: [journalEntryId], references: [id])
  status       TransactionStatus @relation(fields: [statusId], references: [id])
}

// Pares de trading spot
model TradingPair {
  id                Int    @id @default(autoincrement())
  baseCurrencyCode  String @db.VarChar(5)
  quoteCurrencyCode String @db.VarChar(5)

  baseCurrency  Currency @relation("BaseCurrency", fields: [baseCurrencyCode], references: [code])
  quoteCurrency Currency @relation("QuoteCurrency", fields: [quoteCurrencyCode], references: [code])

  @@unique([baseCurrencyCode, quoteCurrencyCode])
}

// Órdenes de trading spot
model TradingOrder {
  id               Int         @id @default(autoincrement())
  accountId        Int
  symbol           String
  orderId          Int         @unique
  client_order_id  String      @unique
  side             OrderSide
  price            Decimal?
  quantity         Decimal
  quantityExecuted Decimal
  status           OrderStatus @default(OPEN)
  type             OrderType
  stopPrice        Decimal?
  quantityStop     Decimal?
  isWorking        Boolean     @default(true)
  profit_loss      Decimal?
  closed_time      DateTime?

  closingOrderId Int?
  closingOrder   TradingOrder? @relation("OrderClosing", fields: [closingOrderId], references: [id])

  // Campo inverso para que Prisma entienda la relación 1 - 1 o 1 - n
  closedByOrders TradingOrder[] @relation("OrderClosing")

  account      Account            @relation(fields: [accountId], references: [id])
  executions   TradingExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, symbol])
  @@index([status])
}

enum OrderType {
  LIMIT
  MARKET
  STOP_LIMIT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELED
  CLOSED
}

// Ejecuciones de órdenes de trading
model TradingExecution {
  id             Int      @id @default(autoincrement())
  orderId        Int
  tradePrice     Decimal
  tradeQuantity  Decimal
  tradeTimestamp DateTime @default(now())

  tradingOrder TradingOrder @relation(fields: [orderId], references: [id])
}

model TradingStrategy {
  id           String       @unique
  symbol       String
  typeId       Int
  type         StrategyType @relation(fields: [typeId], references: [id])
  strategyType String?
  config       Json // Guarda configuración específica como JSON
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  botRuns BotRun[]

  @@index([typeId]) // Índice para mejorar consultas por tipo
}

model StrategyType {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  strategies  TradingStrategy[] // Relación uno a muchos
}

model CryptoPrice {
  id        Int      @id @default(autoincrement())
  symbol    String // Ejemplo: "BTC"
  price     Float // Precio en USD u otra moneda
  volume    Float? // Volumen negociado
  timestamp DateTime // Fecha y hora del registro de precio
  createdAt DateTime @default(now())

  @@index([symbol, timestamp])
}

// Configuración global de riesgo (singleton, id=1)
model RiskConfig {
  id                          Int       @id @default(1)
  enabled                     Boolean   @default(true)
  maxDailyLossQuote           Decimal? // pérdida absoluta día (quote)
  maxDrawdownPct              Float? // % drawdown per-bot
  maxOpenBots                 Int? // máximo bots simultáneos
  maxLossPerBotQuote          Decimal? // pérdida absoluta per-bot
  minWinRatePct               Float? // si baja, stop
  minTradesForWinRateEval     Int       @default(20)
  emergencyStopUntil          DateTime?
  // Nuevos guards
  guardBufferPct              Float     @default(4) // % buffer sobre balance FDUSD/quote para CryptoGuard
  guardConfirmTicks           Int       @default(3) // ticks consecutivos bajo threshold para disparar
  guardCooldownMinutes        Int       @default(15) // cooldown tras disparar guard
  consecutiveLossLimit        Int? // N trades perdedores seguidos → stop
  includeUnrealizedInDailyLoss Boolean  @default(true) // sumar unrealized al daily loss check
  maxCrossBotExposurePct      Float? // % equity global máximo abierto entre todos los bots
  updatedAt                   DateTime  @updatedAt
  createdAt                   DateTime  @default(now())
}

// Paper trading — órdenes simuladas
enum PaperOrderStatus {
  OPEN
  FILLED
  CANCELED
}

model PaperOrder {
  id          Int              @id @default(autoincrement())
  botRunId    Int?
  externalId  String           @unique // id sintético devuelto a la strategy
  symbol      String
  side        OrderSide
  type        String // LIMIT, MARKET, STOP_LOSS, STOP_LOSS_LIMIT
  price       Decimal?
  stopPrice   Decimal?
  quantity    Decimal
  status      PaperOrderStatus @default(OPEN)
  filledPrice Decimal?
  filledAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([symbol, status])
  @@index([botRunId])
}

// Evento de riesgo detectado
model RiskEvent {
  id        Int      @id @default(autoincrement())
  type      String // MAX_LOSS, MAX_DRAWDOWN, DAILY_LOSS, MANUAL_STOP, EMERGENCY, WIN_RATE
  botRunId  Int?
  symbol    String?
  message   String
  action    String // STOPPED_BOT, STOPPED_ALL, NOTIFIED, IGNORED
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([botRunId])
}

// Vela OHLCV por intervalo (1m, 5m, 15m, 1h, 4h, 1d, etc.)
model Candle {
  id        Int      @id @default(autoincrement())
  symbol    String
  interval  String // "1m", "5m", "1h" ...
  openTime  DateTime
  closeTime DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  trades    Int?
  createdAt DateTime @default(now())

  @@unique([symbol, interval, openTime])
  @@index([symbol, interval, closeTime])
}

model MarketRegimeSnapshot {
  id                Int      @id @default(autoincrement())
  symbol            String
  timeframe         String
  candleCloseTime   DateTime
  regime            String
  trend             String
  volatility        String
  volume            String
  confidence        Float
  trendStrengthPct  Float?
  atrPct             Float?
  efficiencyRatio   Float?
  volumeRatio        Float?
  indicators         Json?
  createdAt          DateTime @default(now())

  @@unique([symbol, timeframe, candleCloseTime])
  @@index([symbol, timeframe, candleCloseTime])
  @@index([regime, candleCloseTime])
}

// Motor de confluencia y confianza de señales: combina régimen de mercado,
// alineación multi-timeframe e indicadores de momentum en un único score
// direccional explicable. Informativo — no bloquea ni autoriza órdenes por
// sí solo (ver src/confluence).
model ConfluenceSnapshot {
  id              Int      @id @default(autoincrement())
  symbol          String
  timeframe       String
  candleCloseTime DateTime
  score           Float // 0-100, 50 = neutral, >50 = sesgo alcista, <50 = sesgo bajista
  bias            String // BULLISH | BEARISH | NEUTRAL
  confidence      Float // 0-100, qué tanto coinciden los componentes entre sí
  regimeScore     Float
  mtfScore        Float
  momentumScore   Float
  breakdown       Json // detalle por componente para auditar la decisión
  createdAt       DateTime @default(now())

  @@unique([symbol, timeframe, candleCloseTime])
  @@index([symbol, timeframe, candleCloseTime])
  @@index([bias, candleCloseTime])
}

model MultiTimeframeEvaluation {
  id               Int       @id @default(autoincrement())
  botRunnerRunId   Int
  correlationId    String    @unique
  symbol           String
  primaryTimeframe String
  side             OrderSide
  score            Float
  aligned          Boolean
  contexts         Json
  createdAt        DateTime  @default(now())

  botRunnerRun BotRunnerRun @relation(fields: [botRunnerRunId], references: [id], onDelete: Cascade)

  @@index([botRunnerRunId, createdAt])
  @@index([symbol, createdAt])
}

// Predicción estadística de precio (AR+GARCH) por símbolo/timeframe/vela
// cerrada. Ventaja probabilística, no garantía -- nunca coloca ni ajusta
// una orden por sí sola, solo alimenta un filtro opcional (config.priceForecast)
// que pasa igual por el motor de riesgo.
model PriceForecastSnapshot {
  id                 Int       @id @default(autoincrement())
  symbol             String
  timeframe          String
  candleCloseTime    DateTime
  horizonBars        Int
  lastPrice          Decimal
  forecastPrice      Decimal
  lowerBound         Decimal
  upperBound         Decimal
  confidencePct      Float
  volatilityForecast Decimal
  modelType          String
  modelParams        Json?
  samplesUsed        Int
  realizedPrice      Decimal?
  evaluatedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@unique([symbol, timeframe, candleCloseTime, horizonBars])
  @@index([symbol, timeframe, createdAt])
  @@index([realizedPrice])
}

model Alert {
  id        Int      @id @default(autoincrement())
  symbol    String // Símbolo del activo (ejemplo: "BTCUSDT")
  price     Float // Precio objetivo para la alerta
  up_down   UpDown // Condición: arriba o abajo (usando enum para mejor control)
  volume    Float? // Volumen negociado opcional
  timestamp DateTime // Momento del registro del precio
  createdAt DateTime @default(now())
  chatId    BigInt? // Chat de Telegram que creó la alerta; null en alertas legacy/creadas sin chat

  @@index([symbol, timestamp])
}

enum UpDown {
  up
  down
}

// Ejecución concreta de una estrategia (bot corriendo)
enum BotRunStatus {
  RUNNING
  STOPPED
  ERROR
}

model BotRun {
  id             Int          @id @default(autoincrement())
  strategyId     String
  ownerId        Int?
  symbol         String
  strategyType   String?
  status         BotRunStatus @default(RUNNING)
  initialQuote   Decimal? // capital inicial en quote currency
  configSnapshot Json? // copia de config al arrancar
  startedAt      DateTime     @default(now())
  stoppedAt      DateTime?
  errorMessage   String?

  strategy     TradingStrategy @relation(fields: [strategyId], references: [id])
  metrics      BotMetric[]
  tradeResults TradeResult[]

  @@index([strategyId])
  @@index([symbol, status])
  @@index([startedAt])
  @@index([ownerId])
}

// Snapshot periódico de métricas por bot
model BotMetric {
  id            Int      @id @default(autoincrement())
  botRunId      Int
  ts            DateTime @default(now())
  realizedPnl   Decimal  @default(0)
  unrealizedPnl Decimal  @default(0)
  openPositions Int      @default(0)
  tradesCount   Int      @default(0)
  winCount      Int      @default(0)
  lossCount     Int      @default(0)
  lastPrice     Decimal?
  extra         Json? // campo libre (drawdown, sharpe, etc.)

  botRun BotRun @relation(fields: [botRunId], references: [id], onDelete: Cascade)

  @@index([botRunId, ts])
}

// Resultado de una operación cerrada (par buy+sell)
model TradeResult {
  id              Int      @id @default(autoincrement())
  botRunId        Int
  externalOrderId String? // orderId de Binance/exchange
  symbol          String
  side            OrderSide
  entryPrice      Decimal
  exitPrice       Decimal
  quantity        Decimal
  pnl             Decimal // en quote currency
  pnlPct          Decimal // porcentaje
  fees            Decimal  @default(0)
  mae             Decimal? // max adverse excursion (pérdida máxima intra-trade en quote)
  maePct          Decimal? // MAE %
  mfe             Decimal? // max favorable excursion (ganancia máxima intra-trade en quote)
  mfePct          Decimal? // MFE %
  openedAt        DateTime
  closedAt        DateTime @default(now())

  botRun BotRun @relation(fields: [botRunId], references: [id], onDelete: Cascade)

  @@index([botRunId, closedAt])
  @@index([symbol, closedAt])
}

// --- Backtesting ---
enum BacktestStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model BacktestRun {
  id             Int            @id @default(autoincrement())
  strategyId     String
  strategyVersion String?
  exchange       String         @default("binance")
  symbol         String
  timeframe      String
  startTime      DateTime
  endTime        DateTime
  initialQuote   Decimal
  finalQuote     Decimal?
  config         Json
  fees           Json?
  status         BacktestStatus @default(PENDING)
  errorMessage   String?

  // metrics (denormalized for fast list queries)
  totalTrades    Int?
  winningTrades  Int?
  losingTrades   Int?
  winRate        Float?
  profitFactor   Float?
  sharpeRatio    Float?
  sortinoRatio   Float?
  maxDrawdownPct Float?
  totalReturnPct Float?
  expectancy     Float?

  metrics        Json?      // full metrics payload
  equityCurve    Json?      // array of {t, equity}
  createdBy      Int?
  createdAt      DateTime   @default(now())
  completedAt    DateTime?

  trades         BacktestTrade[]

  @@index([strategyId])
  @@index([symbol, timeframe])
  @@index([status])
  @@index([createdAt])
}

// --- Copy Trading ---
enum CopyVisibility {
  PRIVATE
  PUBLIC
}

enum CopyMode {
  MIRROR
  PROPORTIONAL
  FIXED_QUOTE
}

model CopyMaster {
  id               Int             @id @default(autoincrement())
  runId            String          @unique
  ownerId          Int?
  name             String
  description      String?
  visibility       CopyVisibility  @default(PRIVATE)
  performanceScore Float?
  followerCount    Int             @default(0)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  subscriptions CopySubscription[]
  events        CopyEvent[]

  @@index([visibility, active])
  @@index([ownerId])
}

model CopySubscription {
  id             Int      @id @default(autoincrement())
  masterId       Int
  followerRunId  String
  ownerId        Int?
  exchangeMode   String   // 'real' | 'paper'
  exchangeId     String?
  paperAccountId Int?
  mode           CopyMode @default(PROPORTIONAL)
  sizeMultiplier Float    @default(1)
  fixedQuote     Float?
  maxRiskPct     Float?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  master  CopyMaster        @relation(fields: [masterId], references: [id], onDelete: Cascade)
  events  CopyExecution[]

  @@unique([masterId, followerRunId])
  @@index([followerRunId])
  @@index([active])
}

model CopyEvent {
  id            Int      @id @default(autoincrement())
  masterId      Int
  signal        Json
  fanoutCount   Int      @default(0)
  emittedAt     DateTime @default(now())

  master     CopyMaster       @relation(fields: [masterId], references: [id], onDelete: Cascade)
  executions CopyExecution[]

  @@index([masterId, emittedAt])
}

model CopyExecution {
  id             Int      @id @default(autoincrement())
  copyEventId    Int
  subscriptionId Int
  orderId        String?
  status         String   // 'FILLED' | 'REJECTED' | 'ERROR'
  reason         String?
  price          Decimal?
  quantity       Decimal?
  quoteQuantity  Decimal?
  executedAt     DateTime @default(now())

  copyEvent    CopyEvent        @relation(fields: [copyEventId], references: [id], onDelete: Cascade)
  subscription CopySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([copyEventId])
  @@index([subscriptionId, executedAt])
}

// --- Bot Runner v2 persistence ---
enum RunnerStatus {
  RUNNING
  STOPPED
  ERROR
}

model BotRunnerRun {
  id             Int          @id @default(autoincrement())
  runId          String       @unique
  strategyId     String
  ownerId        Int?
  symbol         String
  timeframe      String
  exchangeMode   String
  exchangeId     String?
  paperAccountId Int?
  riskProfileId  Int?
  status         RunnerStatus @default(RUNNING)
  config         Json
  initialEquity  Decimal?
  peakEquity     Decimal?
  finalEquity    Decimal?
  dailyPnl       Decimal      @default(0)
  realizedPnl    Decimal      @default(0)
  ticks          Int          @default(0)
  signals        Int          @default(0)
  ordersPlaced   Int          @default(0)
  ordersRejected Int          @default(0)
  errors         Int          @default(0)
  lastError      String?
  startedAt      DateTime     @default(now())
  stoppedAt      DateTime?

  trades    BotRunnerTrade[]
  snapshots BotRunnerSnapshot[]
  traces    BotRunnerTrace[]
  executions ExecutionMetric[]
  reconciliationBatches ReconciliationBatch[]
  reconciliationIssues  ReconciliationIssue[]
  timeframeEvaluations  MultiTimeframeEvaluation[]

  @@index([status])
  @@index([ownerId])
  @@index([symbol, startedAt])
}

// Calidad y costo observado entre la intención de orden y la respuesta del exchange.
model ExecutionMetric {
  id                Int      @id @default(autoincrement())
  botRunnerRunId    Int
  correlationId     String   @unique
  orderId           String?
  exchange           String
  mode               String
  symbol             String
  side               OrderSide
  orderType          String
  market             String   @default("SPOT")
  status              String
  expectedPrice      Decimal?
  bestBid            Decimal?
  bestAsk            Decimal?
  spreadBps          Decimal?
  requestedQuantity Decimal?
  filledQuantity    Decimal?
  fillPrice          Decimal?
  notional           Decimal?
  fee                Decimal  @default(0)
  feeCurrency        String?
  slippageBps        Decimal?
  slippageQuote      Decimal?
  latencyMs          Int?
  errorCode          String?
  errorMessage       String?
  requestedAt        DateTime
  respondedAt        DateTime
  createdAt          DateTime @default(now())

  botRunnerRun BotRunnerRun @relation(fields: [botRunnerRunId], references: [id], onDelete: Cascade)

  @@index([botRunnerRunId, requestedAt])
  @@index([symbol, requestedAt])
  @@index([status, requestedAt])
  @@index([mode, requestedAt])
}

model ReconciliationBatch {
  id               Int      @id @default(autoincrement())
  botRunnerRunId   Int
  trigger          String
  status           String   @default("RUNNING")
  exchange         String
  mode             String
  ordersChecked    Int      @default(0)
  positionsChecked Int      @default(0)
  balancesChecked  Int      @default(0)
  issuesFound      Int      @default(0)
  repairsApplied   Int      @default(0)
  balanceSnapshot  Json?
  positionSnapshot Json?
  errorMessage     String?
  startedAt        DateTime @default(now())
  completedAt      DateTime?

  botRunnerRun BotRunnerRun         @relation(fields: [botRunnerRunId], references: [id], onDelete: Cascade)
  issues       ReconciliationIssue[]

  @@index([botRunnerRunId, startedAt])
  @@index([status, startedAt])
}

model ReconciliationIssue {
  id               Int      @id @default(autoincrement())
  fingerprint      String   @unique
  batchId          Int
  botRunnerRunId   Int
  type             String
  severity         String
  entityType       String
  entityId         String?
  localState       Json?
  remoteState      Json?
  action           String   @default("REQUIRES_MANUAL")
  status           String   @default("OPEN")
  occurrenceCount  Int      @default(1)
  resolution       String?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  resolvedAt       DateTime?

  batch        ReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  botRunnerRun BotRunnerRun         @relation(fields: [botRunnerRunId], references: [id], onDelete: Cascade)

  @@index([botRunnerRunId, status, lastSeenAt])
  @@index([severity, status, lastSeenAt])
  @@index([type, status])
}

// Historial append-only que conecta estrategia, riesgo, orden y resultado.
// correlationId agrupa todos los eventos producidos por una misma señal.
model BotRunnerTrace {
  id             Int      @id @default(autoincrement())
  botRunnerRunId Int
  correlationId  String
  eventType      String
  symbol         String
  orderId        String?
  tradeId        Int?
  payload        Json?
  occurredAt     DateTime @default(now())

  botRunnerRun BotRunnerRun @relation(fields: [botRunnerRunId], references: [id], onDelete: Cascade)

  @@index([botRunnerRunId, occurredAt])
  @@index([correlationId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([orderId])
}

model BotRunnerTrade {
  id             Int      @id @default(autoincrement())
  botRunnerRunId Int
  orderId        String
  symbol         String
  side           OrderSide
  entryPrice     Decimal
  exitPrice      Decimal?
  quantity       Decimal
  fee            Decimal   @default(0)
  pnl            Decimal?
  pnlPct         Decimal?
  // Cierres parciales (tp-ladder): cuánto de `quantity` ya se realizó antes
  // del cierre final, y la suma de pnl ya realizado en esos fills
  // parciales -- sin esto, closeTrade() valuaba el 100% de la posición al
  // precio del ÚLTIMO nivel (el mejor, porque el ladder vende en niveles
  // crecientes), sobreestimando la ganancia real de cada trade con
  // tp-ladder. Ver convención de tp-ladder en CLAUDE.md.
  closedQuantity      Decimal @default(0)
  realizedPnlToDate   Decimal @default(0)
  mae            Decimal?
  maePct         Decimal?
  mfe            Decimal?
  mfePct         Decimal?
  peakPrice      Decimal?
  troughPrice    Decimal?
  stopLossPrice  Decimal?
  initialRisk    Decimal?
  rMultiple      Decimal?
  reason         String?
  marketRegime   String?
  regimeConfidence Float?
  regimeSnapshot Json?
  timeframeScore Float?
  timeframeSnapshot Json?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  botRunnerRun BotRunnerRun @relation(fields: [botRunnerRunId], references: [id], onDelete: Cascade)

  @@index([botRunnerRunId, closedAt])
  @@index([symbol, openedAt])
}

model BotRunnerSnapshot {
  id             Int      @id @default(autoincrement())
  botRunnerRunId Int
  ts             DateTime @default(now())
  equity         Decimal
  drawdownPct    Float    @default(0)
  openPositions  Int      @default(0)
  extras         Json?

  botRunnerRun BotRunnerRun @relation(fields: [botRunnerRunId], references: [id], onDelete: Cascade)

  @@index([botRunnerRunId, ts])
}

// --- Risk profiles + kill switch ---
model RiskProfile {
  id                 Int      @id @default(autoincrement())
  ownerId            Int?
  name               String
  maxDrawdownPct     Float    @default(20)
  maxDailyLossPct    Float    @default(5)
  maxPositionSizePct Float    @default(10)
  maxOpenPositions   Int      @default(5)
  sizer              Json?    // { type: 'fixed-pct' | 'kelly' | 'atr-vol', config: {...} }
  trailingStop       Json?    // TrailingStopConfig
  tpLadder           Json?    // TpLadderConfig
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId])
  @@index([enabled])
}

model KillSwitch {
  id         Int      @id @default(autoincrement())
  scope      String   // 'GLOBAL' | 'USER' | 'BOT'
  targetId   String?  // userId or runId
  enabled    Boolean  @default(false)
  reason     String?
  triggeredAt DateTime?
  triggeredBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, targetId])
  @@index([enabled])
}

model CapitalEvent {
  id             Int      @id @default(autoincrement())
  type           String   // TRADE_PNL | FEE | FUNDING | INTEREST | REBATE | DEPOSIT | WITHDRAWAL | ADJUSTMENT
  amount         Decimal
  currency       String   @default("USDT")
  botRunnerRunId Int?
  tradeId        Int?
  correlationId  String?
  source         String?  // exchange id or 'CAPITAL_GUARD' etc.
  externalId     String?
  occurredAt     DateTime @default(now())
  payload        Json?

  @@unique([source, externalId], name: "CapitalEvent_source_externalId_key")
  @@index([type, occurredAt])
  @@index([botRunnerRunId, occurredAt])
  @@index([tradeId])
  @@index([correlationId])
}

model OperationalAlert {
  id               Int      @id @default(autoincrement())
  kind             String
  severity         String   @default("INFO") // INFO | WARN | ERROR | CRITICAL
  subject          String
  message          String
  dedupeKey        String   @unique
  occurrenceCount  Int      @default(1)
  botRunnerRunId   Int?
  payload          Json?
  firstOccurredAt  DateTime @default(now())
  lastOccurredAt   DateTime @default(now())
  acknowledgedAt   DateTime?
  acknowledgedBy   String?

  @@index([kind, lastOccurredAt])
  @@index([severity, acknowledgedAt])
  @@index([botRunnerRunId])
}

// Registro técnico append-only de solicitudes HTTP para medir cobertura,
// latencia, errores y contexto operativo sin guardar secretos ni cuerpos.
model AuditEvent {
  id          Int      @id @default(autoincrement())
  requestId   String   @db.VarChar(80)
  eventType   String   @default("HTTP_REQUEST") @db.VarChar(64)
  userId      Int?
  method      String   @db.VarChar(12)
  path        String   @db.VarChar(512)
  statusCode  Int
  durationMs  Int
  ipAddress   String?  @db.VarChar(128)
  userAgent   String?  @db.VarChar(512)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
  @@index([path, createdAt])
}

// --- Paper trading (virtual account) ---
model PaperAccount {
  id           Int      @id @default(autoincrement())
  ownerId      Int?
  name         String
  quoteAsset   String   @default("USDT")
  initialQuote Decimal
  balances     Json     // { [asset: string]: { free: number, locked: number, avgEntry?: number } }
  feesConfig   Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fills        PaperFill[]

  @@index([ownerId])
  @@index([active])
}

model PaperFill {
  id             Int        @id @default(autoincrement())
  paperAccountId Int
  orderId        String
  symbol         String
  side           OrderSide
  type           String
  price          Decimal
  quantity       Decimal
  quoteQuantity  Decimal
  fee            Decimal    @default(0)
  feeAsset       String?
  reason         String?
  filledAt       DateTime   @default(now())

  paperAccount   PaperAccount @relation(fields: [paperAccountId], references: [id], onDelete: Cascade)

  @@index([paperAccountId, filledAt])
  @@index([symbol, filledAt])
}

model BacktestTrade {
  id             Int          @id @default(autoincrement())
  backtestRunId  Int
  side           OrderSide
  entryTime      DateTime
  exitTime       DateTime
  entryPrice     Decimal
  exitPrice      Decimal
  quantity       Decimal
  pnl            Decimal
  pnlPct         Decimal
  fees           Decimal      @default(0)
  reason         String?
  bars           Int?         // bars held

  backtestRun    BacktestRun  @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)

  @@index([backtestRunId, exitTime])
}
