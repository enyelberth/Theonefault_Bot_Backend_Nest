DATABASE_URL=
DATABASE_URL3=
DIRECT_URL=

# Auth JWT secrets (obligatorios; generar valores aleatorios largos, nunca reusar entre entornos)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Binance credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_KEY2=
BINANCE_API_SECRET2=
BINANCE_API_KEY_PROD=
BINANCE_API_SECRET_PROD=
BINANCE_API_KEY_TEST=
BINANCE_API_SECRET_TEST=

# Puertos del servidor (opcionales; defaults 50000/50001)
PORT=50000
FRONT_PORT=50001

# Application URLs and AI/bot integrations
BASE_URL=
BASE_URL2=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
# IDs de usuario de Telegram con permiso admin (cuentas/saldos/estrategias), separados por coma
TELEGRAM_ADMIN_IDS=
# Chats que reciben alertas de PnL y alertas de precio sin chat propio, separados por coma
TELEGRAM_NOTIFY_CHAT_IDS=
# Umbral en USD de variación de PnL no realizado para disparar alerta (default 1)
PNL_ALERT_THRESHOLD_USD=1
TELEGRAM_SOFIA_BOT_TOKEN=
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_USERNAME=
SEED_USER_KEY=
SEED_USER_SECRET_KEY=
SEED_ACCOUNT_EMAIL=
SEED_ACCOUNT_PASSWORD=
SEED_ACCOUNT_KEY=
SEED_ACCOUNT_SECRET_KEY=
BOOT=
BOOT2=
SOFIA_BOT=
NODE_ENV=development

# Feature flags Binance
PRODUCTION=false
MARGIN=false
BINANCE_BASE_URL_PROD=https://api.binance.com
BINANCE_BASE_URL_TEST=https://testnet.binance.vision
# Habilita BNB burn para fee -25% (default true si se omite)
BINANCE_AUTO_BNB_BURN=true
# Umbral de saldo BNB bajo antes de alertar (default 0.05 si se omite)
BINANCE_BNB_LOW_THRESHOLD=0.05
