# Runtime
PRODUCTION=false
PORT=4000
ENABLE_MARGIN_IN_DEV=false

# Canonical variables (single source of truth)
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/theonefault_dev"
DIRECT_URL="postgresql://app_user:app_password@localhost:5432/theonefault_dev"

BASE_URL="https://testnet.binance.vision"
BINANCE_API_KEY="replace_with_binance_api_key"
BINANCE_API_SECRET="replace_with_binance_api_secret"

JWT_SECRET="replace_with_jwt_secret"
JWT_REFRESH_SECRET="replace_with_jwt_refresh_secret"

GEMINI_API_KEY="replace_with_gemini_api_key"
BOOT="replace_with_telegram_bot_token"
BOOT2="replace_with_secondary_telegram_bot_token"
SOFIA_BOT="replace_with_sofia_bot_token"
TELEGRAM_INTERNAL_TOKEN="replace_with_internal_telegram_token"
ADMIN_TELEGRAM_IDS="123456789"
NOTIFY_TELEGRAM_CHATS="123456789"

# Optional compatibility aliases used by runtime-env.ts
# DATABASE_URL_DEV=""
# DATABASE_URL_PROD=""
# DIRECT_URL_DEV=""
# DIRECT_URL_PROD=""
# BINANCE_API_KEY_DEV=""
# BINANCE_API_KEY_PROD=""
# BINANCE_API_SECRET_DEV=""
# BINANCE_API_SECRET_PROD=""
# BASE_URL_DEV=""
