PRODUCTION=false
ENABLE_MARGIN_IN_DEV=false
PORT=4000

# Database
DATABASE_URL_PROD="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL_PROD="postgresql://user:password@host:5432/dbname?sslmode=require"

DATABASE_URL_DEV="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL_DEV="postgresql://user:password@localhost:5432/dbname"

# Binance
BINANCE_API_KEY_PROD="your_binance_prod_key"
BINANCE_API_SECRET_PROD="your_binance_prod_secret"
BASE_URL_PROD="https://api.binance.com"

BINANCE_API_KEY_DEV="your_binance_testnet_key"
BINANCE_API_SECRET_DEV="your_binance_testnet_secret"
BASE_URL_DEV="https://testnet.binance.vision"

# Optional services
GEMINI_API_KEY="your_gemini_key"
BOOT="your_telegram_bot_token"
BOOT2="your_secondary_telegram_bot_token"
SOFIA_BOT="your_sofia_bot_token"
TELEGRAM_INTERNAL_TOKEN="your_internal_telegram_http_token"
ADMIN_TELEGRAM_IDS="7276654069"
NOTIFY_TELEGRAM_CHATS="7276654069"

# Optional explicit JWT keys
# JWT_SECRET_PROD=""
# JWT_SECRET_DEV=""
# JWT_REFRESH_SECRET_PROD=""
# JWT_REFRESH_SECRET_DEV=""
