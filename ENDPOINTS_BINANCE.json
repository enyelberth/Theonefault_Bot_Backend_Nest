          },
          {
            "name": "quantity",
            "type": "string",
            "required": true
          },
          {
            "name": "price",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "name": "Crear Orden Market Margin Cruzado",
        "path": "/order/market/cross",
        "method": "POST",
        "auth": true,
        "description": "Crea una orden market con margen cruzado",
        "parameters": [
          {
            "name": "symbol",
            "type": "string",
            "required": true
          },
          {
            "name": "side",
            "type": "string",
            "required": true,
            "enum": ["BUY", "SELL"]
          },
          {
            "name": "quantity",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "name": "Cancelar Orden Margin",
        "path": "/margin-cross/order/cancel/:symbol/:orderId",
        "method": "POST",
        "auth": true,
        "description": "Cancela una orden específica de margin cruzado",
        "parameters": [
          {
            "name": "symbol",
            "type": "string",
            "required": true,
            "location": "path"
          },
          {
            "name": "orderId",
            "type": "number",
            "required": true,
            "location": "path"
          }
        ]
      },
      {
        "name": "Obtener Posiciones Margin",
        "path": "/margin-cross/positions",
        "method": "GET",
        "auth": true,
        "description": "Obtiene todas las posiciones abiertas en margin cruzado"
      },
      {
        "name": "Obtener Posición Específica",
        "path": "/margin-cross/position/:symbol",
        "method": "GET",
        "auth": true,
        "description": "Obtiene una posición específica de margin cruzado",
        "parameters": [
          {
            "name": "symbol",
            "type": "string",
            "required": true,
            "location": "path"
          }
        ]
      },
      {
        "name": "Repagar Préstamo Margin",
        "path": "/margin-cross/repay",
        "method": "POST",
        "auth": true,
        "description": "Repaga un préstamo en margin cruzado",
        "parameters": [
          {
            "name": "asset",
            "type": "string",
            "required": true,
            "description": "Activo a repagar (ej: USDT, BTC)"
          },
          {
            "name": "amount",
            "type": "string",
            "required": true,
            "description": "Cantidad a repagar"
          }
        ],
        "body": {
          "asset": "USDT",
          "amount": "1000"
        }
      }
    ]
  },
  "errors": {
    "400": {
      "description": "Bad Request - Parámetros inválidos",
      "action": "Verifica los parámetros enviados"
    },
    "401": {
      "description": "Unauthorized - Token inválido",
      "action": "Vuelve a autenticar"
    },
    "404": {
      "description": "Not Found - Recurso no existe",
      "action": "Verifica los parámetros (symbol, orderId, etc)"
    },
    "500": {
      "description": "Internal Server Error",
      "action": "Intenta de nuevo, contacta a soporte"
    }
  },
  "httpStatusCodes": {
    "200": "OK - Solicitud exitosa",
    "201": "Created - Recurso creado",
    "400": "Bad Request",
    "401": "Unauthorized",
    "404": "Not Found",
    "500": "Internal Server Error"
  },
  "exampleUsage": {
    "nodejs": "const axios = require('axios');\nconst client = axios.create({\n  baseURL: 'http://localhost:3000/binance',\n  headers: { 'Authorization': 'Bearer YOUR_TOKEN' }\n});\nawait client.get('/wallet/funds-summary');",
    "curl": "curl -X GET http://localhost:3000/binance/wallet/funds-summary \\\n  -H 'Authorization: Bearer YOUR_TOKEN'",
    "typescript": "const response = await fetch('http://localhost:3000/binance/wallet/funds-summary', {\n  headers: { 'Authorization': 'Bearer YOUR_TOKEN' }\n});\nconst data = await response.json();"
  }
